' antigravity-hans launcher (no console window)
'
' This file is generated by install.ps1 with the node path it detected.
' __NODE_EXE__ is replaced at install time.
'
' arg 0 = hidden window, arg False = do not wait (return immediately).
Option Explicit

Dim fso, sh, scriptDir, projectDir, daemon

Set fso = CreateObject("Scripting.FileSystemObject")
Set sh = CreateObject("WScript.Shell")

scriptDir = fso.GetParentFolderName(WScript.ScriptFullName)
projectDir = fso.GetParentFolderName(scriptDir)
daemon = fso.BuildPath(projectDir, "src\hans-daemon.js")

If Not fso.FileExists(daemon) Then
    MsgBox "antigravity-hans: cannot find the daemon at" & vbCrLf & daemon & vbCrLf & vbCrLf & _
           "Re-run scripts\install.ps1 to repair the installation.", 16, "antigravity-hans"
    WScript.Quit 1
End If

sh.Run """__NODE_EXE__"" """ & daemon & """", 0, False
